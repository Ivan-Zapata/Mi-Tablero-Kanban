# ============================================
# CONFIGURACIÓN PARA DESPLIEGUE EN VERCEL + SUPABASE
# ============================================

# Opción A: Connection String de Supabase (RECOMENDADO para Vercel)
# Obtén esto en: Supabase Dashboard > Settings > Database > Connection string
# Reemplaza [YOUR-PASSWORD] con tu contraseña de Supabase
POSTGRES_URL=postgresql://postgres:[YOUR-PASSWORD]@db.cnaltnysrihalqomoebh.supabase.co:5432/postgres

# ============================================
# CONFIGURACIÓN PARA DESARROLLO LOCAL
# ============================================

# Opción B: Variables individuales (solo desarrollo local)
DB_USER=postgres
DB_PASSWORD=your_password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=postgres

# ============================================
# SEGURIDAD
# ============================================
# Genera una clave secreta: openssl rand -base64 32
JWT_SECRET=your_jwt_secret_key

# ============================================
# NOTAS PARA DESPLIEGUE EN VERCEL:
# ============================================
# 1. Ve a tu proyecto Supabase > Settings > Database > Connection string
# 2. Copia la URI (modo: Session mode)
# 3. En Vercel Dashboard > Tu Proyecto > Settings > Environment Variables
# 4. Añade: POSTGRES_URL = tu_connection_string
# 5. No necesitas las variables DB_USER, DB_PASSWORD, etc. en Vercel
# 6. El código ya soporta SSL automático en producción
